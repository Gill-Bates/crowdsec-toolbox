###### LOGGING ######
# Console log level: DEBUG, INFO (default), WARNING or ERROR.
LOG_LEVEL=INFO

###### SCHEDULING ######
# Read by docker/entrypoint.sh, not by the application. main.py is one-shot;
# the entrypoint turns it into a periodic job.
# RUN_ONCE=true runs a single export and exits (cron-style deployments).
RUN_ONCE=false
# Interval in seconds.
RUN_INTERVAL=60
# Up to this many random seconds are added after each run, before the interval
# sleep — not at container start.
RUN_JITTER=0

###### CROWDSEC LOCAL API ######
# The exporter authenticates against the CrowdSec LAPI as a registered machine,
# exactly like crowdsec-abuse-reporter. It needs no Docker socket.
#
# Read the values from CrowdSec's own watcher credentials:
#   docker exec -it <crowdsec container> cat /etc/crowdsec/local_api_credentials.yaml
# then copy `login` here as CROWDSEC_LAPI_MACHINE_ID and `password` as
# CROWDSEC_LAPI_PASSWORD.
# Inside a container, 127.0.0.1 is the container itself. Use the CrowdSec
# container's name on a shared network, or the host's address.
CROWDSEC_LAPI_URL=http://crowdsec:8080
CROWDSEC_LAPI_MACHINE_ID=
CROWDSEC_LAPI_PASSWORD=
# Verify the LAPI TLS certificate (only relevant for an https:// URL).
CROWDSEC_LAPI_VERIFY_TLS=true
# Request timeout in seconds (minimum 1).
CROWDSEC_LAPI_TIMEOUT=30
# Maximum alerts requested per LAPI call.
CROWDSEC_ALERT_LIMIT=10000
# Fallback for direct host runs: CrowdSec's own credentials file, used for any
# value not set above.
# CROWDSEC_LAPI_CREDENTIALS_PATH=/etc/crowdsec/local_api_credentials.yaml

# Optional host identity override. By default Compose reads the host's
# /etc/hostname; InfluxDB uses it as measurement, QuestDB as the host tag.
HOSTNAME_OVERRIDE=


###### METRICS BACKEND ######
# "influxdb2" (default) or "questdb"; any other value aborts at startup.
METRICS_BACKEND=influxdb2

###### INFLUXDB (used when METRICS_BACKEND=influxdb2) ######
INFLUXDB_URL=iflx.example.com
INFLUXDB_PORT=443
INFLUXDB_USE_HTTPS=true
INFLUXDB_VALIDATE_CERTIFICATE=true
INFLUXDB_ORGANIZATION=myOrg
INFLUXDB_BUCKET=crowdsec
INFLUXDB_TOKEN=

###### QUESTDB (used when METRICS_BACKEND=questdb) ######
# Bare host name only: no scheme, no port, no path.
QUESTDB_URL=questdb.example.com
QUESTDB_PORT=9000
QUESTDB_USE_HTTPS=false
QUESTDB_VALIDATE_CERTIFICATE=true
QUESTDB_TABLE=crowdsec
# Retention set on the table after each write (QuestDB 8.3+):
# 365d, 12w, 6M, 1y, 48h; 0 disables.
QUESTDB_TTL=365d
# Either a bearer token or username+password; the token takes precedence.
QUESTDB_TOKEN=
QUESTDB_USERNAME=
QUESTDB_PASSWORD=

###### PER-EVENT EXPORT ######
# Writes one point per CrowdSec event into a second table, carrying the request
# details (http_path, http_verb, http_status, target_fqdn, target_user).
# Required for the "Top Endpoints" dashboard panels. Off by default because it
# multiplies the written volume by the number of events per alert.
EVENTS_ENABLED=false
EVENTS_TABLE=crowdsec_events
# Window passed to the LAPI `since` parameter. Keep it well above the export
# interval. The whole window is re-sent every run and the backend deduplicates,
# so this also sets the write amplification (window / interval).
EVENTS_SINCE=30m

###### PERFORMANCE ######
REQUEST_TIMEOUT=30
