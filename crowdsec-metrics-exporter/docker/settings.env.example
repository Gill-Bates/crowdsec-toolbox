###### LOGGING ######
LOG_LEVEL=INFO

###### SCHEDULING ######
# One-time export: docker compose run --rm -e RUN_ONCE=true crowdsec-metrics-exporter
RUN_ONCE=false
# Interval in seconds; RUN_EVERY_HOUR can be set instead.
RUN_INTERVAL=60

###### CROWDSEC ######
# Copy your CrowdSec watcher ID and password here.
CROWDSEC_LAPI_URL=http://crowdsec:8080
CROWDSEC_LAPI_MACHINE_ID=
CROWDSEC_LAPI_PASSWORD=
CROWDSEC_LAPI_VERIFY_TLS=true
CROWDSEC_LAPI_TIMEOUT=30
CROWDSEC_ALERT_LIMIT=10000
# Host runs only:
# CROWDSEC_LAPI_CREDENTIALS_PATH=/etc/crowdsec/local_api_credentials.yaml
# Optional host label; blank uses the system hostname.
HOSTNAME_OVERRIDE=

###### METRICS BACKEND ######
# Set to influxdb2 or questdb.
METRICS_BACKEND=influxdb2

###### INFLUXDB ######
INFLUXDB_URL=iflx.example.com
INFLUXDB_PORT=443
INFLUXDB_USE_HTTPS=true
INFLUXDB_VALIDATE_CERTIFICATE=true
INFLUXDB_ORGANIZATION=myOrg
INFLUXDB_BUCKET=crowdsec
INFLUXDB_TOKEN=

###### QUESTDB ######
# QuestDB 10.x is required; enter the hostname only.
QUESTDB_URL=questdb.example.com
QUESTDB_PORT=9000
QUESTDB_USE_HTTPS=false
QUESTDB_VALIDATE_CERTIFICATE=true
QUESTDB_TABLE=crowdsec
# Optional retention and downsampling.
QUESTDB_TTL=365d
# Set to low, medium or high to enable downsampling.
QUESTDB_DOWNSAMPLING=
QUESTDB_TOKEN=
QUESTDB_USERNAME=
QUESTDB_PASSWORD=

###### PER-EVENT EXPORT ######
# Optional; exports more detailed CrowdSec events.
EVENTS_ENABLED=false
EVENTS_TABLE=crowdsec_events
# Lookback window; keep it longer than the run interval.
EVENTS_SINCE=30m

###### CONNECTION ######
REQUEST_TIMEOUT=30
