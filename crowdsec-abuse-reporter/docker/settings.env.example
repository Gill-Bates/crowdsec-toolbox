###### CROWDSEC ######
# Use HTTPS if the LAPI is outside a trusted private network.
CROWDSEC_LAPI_URL=http://crowdsec:8080
CROWDSEC_LAPI_MACHINE_ID=
CROWDSEC_LAPI_PASSWORD=
# Host installs only:
# CROWDSEC_LAPI_CREDENTIALS_PATH=/etc/crowdsec/local_api_credentials.yaml
CROWDSEC_LAPI_VERIFY_TLS=true
CROWDSEC_LAPI_TIMEOUT=30
CROWDSEC_FETCH_ALERT_DETAILS=true
CROWDSEC_DETAIL_LIMIT=500
# Leave blank to detect the reporting identity automatically.
HOSTNAME_OVERRIDE=
PUBLIC_IP_DETECTION=true
PUBLIC_IP_TIMEOUT=5

###### EMAIL ######
SMTP_SERVER=smtp.example.net
SMTP_PORT=587
SMTP_USERNAME=abuse@example.net
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_VERIFY_SSL=true
SMTP_SENDER=abuse@example.net
SENDER_NAME=Example Security Dept.
# Optional copy recipient.
BCC=
SLEEP_BETWEEN_MAILS=10
# Optional pause after this many emails; set to 0 to disable.
MAIL_CHUNK_SIZE=25
SLEEP_BETWEEN_CHUNKS=60
# ASNs to exclude from reports, separated by commas (e.g. AS8881).
WHITELISTED_ASN=

###### DNS ######
ABUSIX_TIMEOUT=3
ABUSIX_DNS_LIFETIME=5

###### REPORTING ######
DB_RETENTION_DAYS=365
PENDING_REAP_MINUTES=60
LOG_LEVEL=INFO
MAX_ALERTS_PER_RUN=0

###### SCHEDULING ######
# RUN_EVERY_HOUR takes precedence over RUN_INTERVAL.
RUN_EVERY_HOUR=6
# RUN_INTERVAL=21600
# One-time run: docker compose run --rm -e RUN_ONCE=true crowdsec-abuse-reporter
RUN_ONCE=false
API_HEARTBEAT_INTERVAL=300
METRICS_INTERVAL=60
# Optional healthcheck overrides:
# METRICS_HEARTBEAT_MAX_AGE_SECONDS=900
# HEALTHCHECK_MAX_AGE_SECONDS=28800
# API_HEARTBEAT_MAX_AGE_SECONDS=700

###### METRICS ######
# Set to none, influxdb2 or questdb.
METRICS_BACKEND=none
REQUEST_TIMEOUT=30
# Retry delays for metric writes.
METRICS_WRITE_RETRIES=2
METRICS_RETRY_BACKOFF=1
# Limits for queued metric points; set either limit to 0 for no limit.
METRICS_OUTBOX_MAX_ROWS=50000
METRICS_OUTBOX_MAX_AGE_DAYS=30

###### INFLUXDB ######
INFLUXDB_URL=iflx.example.com
INFLUXDB_PORT=443
INFLUXDB_USE_HTTPS=true
INFLUXDB_VALIDATE_CERTIFICATE=true
INFLUXDB_ORGANIZATION=myOrg
INFLUXDB_BUCKET=crowdsec
INFLUXDB_TOKEN=

###### QUESTDB ######
# QuestDB 10.x is required; enter the hostname only.
QUESTDB_URL=questdb.example.com
QUESTDB_PORT=9000
# Use HTTPS outside a trusted private network.
QUESTDB_USE_HTTPS=false
QUESTDB_VALIDATE_CERTIFICATE=true
QUESTDB_TABLE=crowdsec-abuse
# Retention period; set to 0 to disable.
QUESTDB_TTL=365d
QUESTDB_TOKEN=
QUESTDB_USERNAME=
QUESTDB_PASSWORD=
