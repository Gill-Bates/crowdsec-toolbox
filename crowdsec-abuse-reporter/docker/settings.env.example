###### GENERAL SETTINGS ######
CROWDSEC_LAPI_URL=http://crowdsec:8080
CROWDSEC_LAPI_MACHINE_ID=
CROWDSEC_LAPI_PASSWORD=
# Optional fallback outside Docker. In Compose, prefer explicit env values.
# CROWDSEC_LAPI_CREDENTIALS_PATH=/etc/crowdsec/local_api_credentials.yaml
CROWDSEC_LAPI_VERIFY_TLS=false
CROWDSEC_LAPI_TIMEOUT=30
CROWDSEC_FETCH_ALERT_DETAILS=true
CROWDSEC_DETAIL_LIMIT=500
# Public reporting identity shown in abuse mails / X-ARF. MUST be set in a
# container, otherwise autodetection returns the private container IP.
HOSTNAME_OVERRIDE=
# If HOSTNAME_OVERRIDE is empty, detect the public WAN IP via external services.
PUBLIC_IP_DETECTION=true
PUBLIC_IP_TIMEOUT=5

###### SMTP CONFIGURATION ######
SMTP_SERVER=smtp.example.net
SMTP_PORT=587
SMTP_USERNAME=abuse@example.net
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_VERIFY_SSL=true
SMTP_SENDER=abuse@example.net
SENDER_NAME=Example Security Dept.
BCC=
SLEEP_BETWEEN_MAILS=10
# Chunked sending: send MAIL_CHUNK_SIZE mails, then pause SLEEP_BETWEEN_CHUNKS
# seconds before the next chunk. MAIL_CHUNK_SIZE=0 disables chunking.
MAIL_CHUNK_SIZE=25
SLEEP_BETWEEN_CHUNKS=60
# ASNs that must NEVER receive an abuse mail (AS-prefix optional, e.g. AS8881)
WHITELISTED_ASN=

###### DNS / ABUSIX ######
# DNS servers come from the container's system resolver (Docker usually 127.0.0.11).
ABUSIX_TIMEOUT=3
ABUSIX_DNS_LIFETIME=5

###### OPERATIONS / LIMITS ######
DB_RETENTION_DAYS=365
PENDING_REAP_MINUTES=60
LOG_LEVEL=INFO
MAX_ALERTS_PER_RUN=0


###### METRICS BACKEND (optional) ######
# Same variables as crowdsec-metrics-exporter. "none" (default) keeps the full
# report audit trail in SQLite. With "influxdb2" or "questdb" each sent/failed
# report is written as a time-series point and SQLite keeps control data only
# (send claim/status per alert+IP, contact cache, last run) — no duplicates.
METRICS_BACKEND=none
# Metrics snapshots are written independently of mail delivery.
# METRICS_INTERVAL=60
REQUEST_TIMEOUT=30

# Report points are spooled to SQLite before the backend write is attempted, so
# an unreachable backend defers them to the next run instead of losing them
# (the mails have already gone out at that point). Replay is idempotent: the
# timestamp is part of the point and of the backend's dedup keys.
# Retries for a single write, before the points are left in the spool.
METRICS_WRITE_RETRIES=2
METRICS_RETRY_BACKOFF=1
# Bounds on the spool so a long outage cannot grow the database without limit.
# Oldest points are dropped first; a spool at 90% of MAX_ROWS makes the run exit
# non-zero, so a prolonged outage still turns the container unhealthy. 0 disables
# a bound (MAX_ROWS=0 also disables the unhealthy escalation).
METRICS_OUTBOX_MAX_ROWS=50000
METRICS_OUTBOX_MAX_AGE_DAYS=30

# InfluxDB 2.x (used when METRICS_BACKEND=influxdb2; token required)
INFLUXDB_URL=iflx.example.com
INFLUXDB_PORT=443
INFLUXDB_USE_HTTPS=true
INFLUXDB_VALIDATE_CERTIFICATE=true
INFLUXDB_ORGANIZATION=myOrg
INFLUXDB_BUCKET=crowdsec
INFLUXDB_TOKEN=

# QuestDB (used when METRICS_BACKEND=questdb)
QUESTDB_URL=questdb.example.com
QUESTDB_PORT=9000
QUESTDB_USE_HTTPS=false
QUESTDB_VALIDATE_CERTIFICATE=true
QUESTDB_TABLE=crowdsec-abuse
# Retention set on the table after each write (QuestDB 8.3+):
# 365d, 12w, 6M, 1y, 48h; 0 disables.
QUESTDB_TTL=365d
# Either a bearer token or username+password; the token takes precedence.
QUESTDB_TOKEN=
QUESTDB_USERNAME=
QUESTDB_PASSWORD=
