{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "crowdsec-abuse-questdb"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      }
    ],
    "cursorSync": "Crosshair",
    "editable": true,
    "elements": {
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Sent",
          "description": "Reports delivered to an abuse contact in the selected range.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "questdb-questdb-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "queryType": "sql",
                        "format": 1,
                        "rawSql": "SELECT count() AS \"Sent\"\nFROM \"${table}\"\nWHERE $__timeFilter(timestamp)\n  AND coalesce(nullif(host, ''), '(unknown)') IN (${host:sqlstring})\n  AND coalesce(nullif(scenario, ''), '(unknown)') IN (${scenario:sqlstring})\n  AND coalesce(nullif(country, ''), '(unknown)') IN (${country:sqlstring})\n  AND status = 'sent';"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.0.2",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "auto",
                "wideLayout": true
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "decimals": 0,
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      }
                    ]
                  },
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "green"
                  },
                  "noValue": "—"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Failed",
          "description": "Reports whose delivery failed. Red is reserved for this.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "questdb-questdb-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "queryType": "sql",
                        "format": 1,
                        "rawSql": "SELECT count() AS \"Failed\"\nFROM \"${table}\"\nWHERE $__timeFilter(timestamp)\n  AND coalesce(nullif(host, ''), '(unknown)') IN (${host:sqlstring})\n  AND coalesce(nullif(scenario, ''), '(unknown)') IN (${scenario:sqlstring})\n  AND coalesce(nullif(country, ''), '(unknown)') IN (${country:sqlstring})\n  AND status = 'failed';"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.0.2",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "auto",
                "wideLayout": true
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "decimals": 0,
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "red"
                  },
                  "noValue": "—"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Success rate",
          "description": "Share of delivery attempts (sent + failed) that succeeded. Excludes METRICS_ONLY snapshot rows (status='observed'), which never attempt delivery.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "questdb-questdb-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "queryType": "sql",
                        "format": 1,
                        "rawSql": "SELECT CASE WHEN count(CASE WHEN status IN ('sent', 'failed') THEN 1 END) > 0\n            THEN 100.0 * count(CASE WHEN status = 'sent' THEN 1 END) / count(CASE WHEN status IN ('sent', 'failed') THEN 1 END)\n       END AS \"Success rate\"\nFROM \"${table}\"\nWHERE $__timeFilter(timestamp)\n  AND coalesce(nullif(host, ''), '(unknown)') IN (${host:sqlstring})\n  AND coalesce(nullif(scenario, ''), '(unknown)') IN (${scenario:sqlstring})\n  AND coalesce(nullif(country, ''), '(unknown)') IN (${country:sqlstring});"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.0.2",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "auto",
                "wideLayout": true
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percent",
                  "decimals": 1,
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "blue"
                      }
                    ]
                  },
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "blue"
                  },
                  "noValue": "—"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-11": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "Total reports",
          "description": "Delivery attempts recorded in the selected range (sent + failed). Excludes METRICS_ONLY snapshot rows (status='observed'), which never attempt delivery.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "questdb-questdb-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "queryType": "sql",
                        "format": 1,
                        "rawSql": "SELECT count(CASE WHEN status IN ('sent', 'failed') THEN 1 END) AS \"Total reports\"\nFROM \"${table}\"\nWHERE $__timeFilter(timestamp)\n  AND coalesce(nullif(host, ''), '(unknown)') IN (${host:sqlstring})\n  AND coalesce(nullif(scenario, ''), '(unknown)') IN (${scenario:sqlstring})\n  AND coalesce(nullif(country, ''), '(unknown)') IN (${country:sqlstring});"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.0.2",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "auto",
                "wideLayout": true
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "decimals": 0,
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "blue"
                      }
                    ]
                  },
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "blue"
                  },
                  "noValue": "—"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Abuse reports per day",
          "description": "Daily buckets (SAMPLE BY 1d). Deliberately not stacked: when failures happen matters more than their share of the total.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "questdb-questdb-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "queryType": "sql",
                        "format": 0,
                        "rawSql": "SELECT timestamp,\n       count(CASE WHEN status = 'sent' THEN 1 END) AS sent,\n       count(CASE WHEN status = 'failed' THEN 1 END) AS failed\nFROM \"${table}\"\nWHERE $__timeFilter(timestamp)\n  AND coalesce(nullif(host, ''), '(unknown)') IN (${host:sqlstring})\n  AND coalesce(nullif(scenario, ''), '(unknown)') IN (${scenario:sqlstring})\n  AND coalesce(nullif(country, ''), '(unknown)') IN (${country:sqlstring})\nSAMPLE BY 1d ALIGN TO CALENDAR\nORDER BY timestamp;"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "barchart",
            "version": "13.0.2",
            "spec": {
              "options": {
                "orientation": "auto",
                "showValue": "never",
                "stacking": "none",
                "groupWidth": 0.7,
                "barWidth": 0.85,
                "barRadius": 0.05,
                "fullHighlight": false,
                "xTickLabelRotation": 0,
                "xTickLabelSpacing": 0,
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "hideZeros": false,
                  "mode": "multi",
                  "sort": "none"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "decimals": 0,
                  "min": 0,
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "green"
                  },
                  "noValue": "—",
                  "custom": {
                    "axisPlacement": "auto",
                    "axisLabel": "",
                    "axisColorMode": "text",
                    "axisCenteredZero": false,
                    "fillOpacity": 35,
                    "gradientMode": "none",
                    "lineWidth": 1,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "failed"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "mode": "fixed",
                          "fixedColor": "red"
                        }
                      },
                      {
                        "id": "custom.fillOpacity",
                        "value": 90
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-12": {
        "kind": "Panel",
        "spec": {
          "id": 12,
          "title": "Top origin countries",
          "description": "Where the reported IPs are located. Top 5 plus 'Other'; codes render as flag emoji, AP/ZZ and unknown as 🌐.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "questdb-questdb-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "queryType": "sql",
                        "format": 1,
                        "rawSql": "WITH country_counts AS (\n    SELECT\n        coalesce(nullif(country, ''), '(unknown)') AS country,\n        count() AS reports\n    FROM \"${table}\"\n    WHERE $__timeFilter(timestamp)\n      AND coalesce(nullif(host, ''), '(unknown)') IN (${host:sqlstring})\n      AND coalesce(nullif(scenario, ''), '(unknown)') IN (${scenario:sqlstring})\n      AND coalesce(nullif(country, ''), '(unknown)') IN (${country:sqlstring})\n    GROUP BY country\n),\nranked AS (\n    SELECT\n        country,\n        reports,\n        row_number() OVER (ORDER BY reports DESC) AS rn\n    FROM country_counts\n),\ngrouped AS (\n    SELECT\n        CASE\n            WHEN rn <= 5 THEN country\n            ELSE 'Other'\n        END AS country,\n        sum(reports) AS reports\n    FROM ranked\n    GROUP BY\n        CASE\n            WHEN rn <= 5 THEN country\n            ELSE 'Other'\n        END\n)\nSELECT\n    CASE\n        WHEN country = 'Other' THEN 'Other'\n        WHEN country ~ '^[A-Za-z]{2}$'\n             AND upper(country) NOT IN ('AP', 'ZZ')\n        THEN concat(\n            substring(\n                '🇦🇧🇨🇩🇪🇫🇬🇭🇮🇯🇰🇱🇲🇳🇴🇵🇶🇷🇸🇹🇺🇻🇼🇽🇾🇿',\n                2 * strpos(\n                    'ABCDEFGHIJKLMNOPQRSTUVWXYZ',\n                    substring(upper(country), 1, 1)\n                ) - 1,\n                2\n            ),\n            substring(\n                '🇦🇧🇨🇩🇪🇫🇬🇭🇮🇯🇰🇱🇲🇳🇴🇵🇶🇷🇸🇹🇺🇻🇼🇽🇾🇿',\n                2 * strpos(\n                    'ABCDEFGHIJKLMNOPQRSTUVWXYZ',\n                    substring(upper(country), 2, 1)\n                ) - 1,\n                2\n            )\n        )\n        ELSE '🌐'\n    END AS \"Country\",\n    reports AS \"Reports\"\nFROM grouped\nORDER BY \"Reports\" DESC;"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "piechart",
            "version": "13.0.2",
            "spec": {
              "options": {
                "displayLabels": [
                  "name",
                  "percent"
                ],
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": false
                },
                "pieType": "donut",
                "reduceOptions": {
                  "calcs": [],
                  "fields": "",
                  "values": true
                },
                "sort": "desc",
                "tooltip": {
                  "hideZeros": false,
                  "mode": "single",
                  "sort": "none"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "decimals": 0,
                  "min": 0,
                  "color": {
                    "mode": "palette-classic"
                  },
                  "noValue": "—",
                  "custom": {
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-9": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Latest abuse reports",
          "description": "Detail view. Columns ordered for triage; Alert and Error sit last.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "questdb-questdb-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "queryType": "sql",
                        "format": 1,
                        "rawSql": "SELECT timestamp AS \"Time\", status AS \"Status\", ip_address AS \"IP\",\n       scenario AS \"Scenario\", country AS \"Country\",\n       abuse_email AS \"Recipient\", as_name AS \"AS Name\",\n       alert_id AS \"Alert\", error_message AS \"Error\"\nFROM \"${table}\"\nWHERE $__timeFilter(timestamp)\n  AND coalesce(nullif(host, ''), '(unknown)') IN (${host:sqlstring})\n  AND coalesce(nullif(scenario, ''), '(unknown)') IN (${scenario:sqlstring})\n  AND coalesce(nullif(country, ''), '(unknown)') IN (${country:sqlstring})\nORDER BY timestamp DESC\nLIMIT 100;"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.0.2",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "enablePagination": true,
                "showHeader": true,
                "footer": {
                  "show": false,
                  "reducer": [
                    "sum"
                  ],
                  "fields": "",
                  "countRows": false
                },
                "sortBy": [
                  {
                    "displayName": "Time",
                    "desc": true
                  }
                ]
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "blue"
                      }
                    ]
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "noValue": "—",
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "footer": {
                      "reducers": []
                    },
                    "inspect": false
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Status"
                    },
                    "properties": [
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-text"
                        }
                      },
                      {
                        "id": "mappings",
                        "value": [
                          {
                            "type": "value",
                            "options": {
                              "sent": {
                                "color": "green",
                                "index": 0
                              },
                              "failed": {
                                "color": "red",
                                "index": 1
                              },
                              "observed": {
                                "color": "orange",
                                "index": 2
                              }
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Alert"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "none"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Time"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "dateTimeAsIso"
                      },
                      {
                        "id": "custom.width",
                        "value": 200
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Recipient"
                    },
                    "properties": [
                      {
                        "id": "noValue",
                        "value": "n/a (observed only)"
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      }
